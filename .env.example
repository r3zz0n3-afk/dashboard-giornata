# Copia questo file in .env e compila i valori.

# --- Calendario iCloud (CalDAV) ---
# L'email del tuo Apple ID
APPLE_ID=tuonome@icloud.com
# Password SPECIFICA PER APP (NON la password dell'Apple ID):
# appleid.apple.com -> Accesso e sicurezza -> Password specifiche per le app
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Facoltativo: mostra solo questi calendari (nomi separati da virgola). Vuoto = tutti.
CALENDARS=

# --- Promemoria dall'iPhone ---
# Una parola segreta lunga a piacere; la stessa va messa nel Comando Rapido.
REMINDERS_TOKEN=cambiami-con-una-frase-lunga

# --- Meteo (Open-Meteo, gratuito e senza chiave) ---
# La tua città, ad esempio: WEATHER_CITY=Bologna. Vuoto = il meteo non viene mostrato.
WEATHER_CITY=
# Ogni quanti secondi richiedere di nuovo le previsioni
WEATHER_SECONDS=900

# --- Server ---
HOST=0.0.0.0
PORT=8080
TIMEZONE=Europe/Rome
# Ogni quanti secondi rileggere il calendario da iCloud
CACHE_SECONDS=300
# DEMO=1 mostra dati finti, utile per provare prima di configurare
DEMO=0
